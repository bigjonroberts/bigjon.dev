{
  "name": "bigjon.dev",
  "version": "1.0.0",
  "description": "Jon Roberts' personal site and blog",
  "type": "module",
  "private": true,
  "scripts": {
    "clean": "rm -rf _site && mkdir -p _site",
    "build": "pnpm clean && pnpm exec eleventy",
    "start": "pnpm exec eleventy --serve --quiet &",
    "eleventy:shutdown": "./util/eleventy-shutdown.sh",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "license": "MIT",
  "packageManager": "pnpm@10.8.0",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/typography": "^0.5.20",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "tailwindcss": "^4.3.4"
  }
}
