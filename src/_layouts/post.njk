---
layout: base.njk
---
<article>
  <header class="mb-8">
    <time datetime="{{ page.date | date('YYYY-MM-DD') }}" class="text-sm text-gray-600 dark:text-gray-400">
      {{ page.date | date('MMMM D, YYYY') }}
    </time>
    <h1 class="mt-1 text-3xl font-extrabold tracking-tight sm:text-4xl">{{ title }}</h1>
    {% set postTags = tags | filterTagList %}
    {% if postTags.length %}
    <ul class="mt-3 flex flex-wrap gap-2" aria-label="Tags">
      {% for tag in postTags %}
      <li>{% include "tag-link.njk" %}</li>
      {% endfor %}
    </ul>
    {% endif %}
  </header>

  <div class="prose max-w-none dark:prose-invert">
    {{ content | safe }}
  </div>
</article>

{% set previousPost = collections.posts | getPreviousCollectionItem %}
{% set nextPost = collections.posts | getNextCollectionItem %}
{% if previousPost or nextPost %}
<nav class="mt-12 flex justify-between gap-4 border-t border-gray-200 pt-6 text-sm dark:border-gray-800" aria-label="More posts">
  <div>{% if previousPost %}<a href="{{ previousPost.url }}" class="text-primary hover:underline dark:text-primary-light">&larr; {{ previousPost.data.title }}</a>{% endif %}</div>
  <div class="text-right">{% if nextPost %}<a href="{{ nextPost.url }}" class="text-primary hover:underline dark:text-primary-light">{{ nextPost.data.title }} &rarr;</a>{% endif %}</div>
</nav>
{% endif %}
