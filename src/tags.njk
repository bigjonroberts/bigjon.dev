---
layout: base.njk
title: Tags
---
<h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Tags</h1>

{% if collections.tagList.length %}
<ul class="mt-6 flex flex-wrap gap-3">
  {% for tag in collections.tagList %}
  <li>{% include "tag-link.njk" %} <span class="text-sm text-gray-600 dark:text-gray-400">({{ collections[tag].length }})</span></li>
  {% endfor %}
</ul>
{% else %}
<p class="mt-4 text-gray-700 dark:text-gray-300">No tags yet.</p>
{% endif %}
